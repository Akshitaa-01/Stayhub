<% layout("./layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2 ">
            <br>
            <h3><%= listing.title %></h3>
            <div class="card listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image" >
                <div class="card-body">
                    <br>
                    <div class="card-text">
                        <p class="listing-owner">
                            <span>Owned by</span> <%= listing.owner.username %>
                        </p>
                        <%= listing.description %>
                        <ul>
                            <li><%= listing.price.toLocaleString('en-IN', {style: 'currency',currency: 'INR'});%> &nbsp; <i>+18% GST</i></li>
                            <li><%= listing.location %></li>
                            <li><%= listing.country %></li>
                        </ul>
                    </div>
                </div>
            
        </div> 
        <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
            <div class="card-btns">
                <a class="btn btn-dark btn-show " href="/listings/<%= listing._id %>/edit">Edit</a>

                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-dark btn-show ">Delete</button>
                </form>   

            </div>
         <% } %>
    </div>
    <div class="col-8 offset-2 mb-3 ">
       <% if (currUser) { %>
            <hr>
            <h5><b>Stayed here? Tell us about it!</b></h5>
            <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
                <div>
                    <label for="rating" class="form-label">  </label>
                    <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
            </div>
                
                <div class="mb-3 ">
                    <label for="comment" class="form-label"><h6>Share your experience with this stay...</h6></label>
                    <br>
                    <textarea id="comment" name="review[comment]" class="form-control review-textarea" placeholder="Tell other guests what you loved..."></textarea> 
                    <h6>Your review can help other guests find their perfect stay.</h6>
 
                    <div class="invalid-feedback">
                        Please add some Comments for review.
                    </div>
                </div>
                <button class="btn btn-dark review-btn">Submit review</button>
            </form>
         <% } %> 
        <hr>
        <% if (listing.reviews.length==0) { %>
            <div class="empty-reviews">
                <h5>No reviews yet</h5>
                <p>Be the first guest to share your experience!</p>
            </div>
        <% } %>
        <% if (listing.reviews.length!=0){ %>
            <h5>All Reviews</h5>
            <div class="row mb-5">
                <% for(let review of listing.reviews ) { %>
                    <div class="card col-5 mb-1 ms-3 mt-2 review-card">
                        <div class="class-body">
                            <p class="review-author">
                                <span>@</span> <b><%= review.author.username%></b>
                            </p>
                            <p class="starability-result card-text" data-rating="<%=  review.rating %>"></p>
                            <p class="card-text"><%=  review.comment %></p>
                            <% if (currUser && currUser._id.equals(review.author._id)) { %>
                                <form class="mb-3" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                                    <button class="btn btn-dark btn-sm btn-review-del ">Delete</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>  
            </div>  
        <% } %>
        <% if (!currUser) { %>
            <div class="review-cta">
                <h5>Stayed here? Tell us about it!</h5>
                <p>Your review can help other guests find their perfect stay.</p>
                <form action="/listings/<%= listing._id %>/reviews" method="post">
                    <button class="btn btn-dark review-btn login-review-btn"> Leave a review</button>
                </form>
                <br>
            </div>
        <% } %>
    </div>
    
</body>
