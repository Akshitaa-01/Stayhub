<div class="filters">
    <% categories.forEach(category => { %>
        <a href="/listings?category=<%= encodeURIComponent(category.name) %>" class="filter">
            <div class="filter-icon">
                <i class="fa-solid <%= category.icon %>"></i>
            </div>
            <p><%= category.name %></p>
        </a>
    <% }); %>
</div>